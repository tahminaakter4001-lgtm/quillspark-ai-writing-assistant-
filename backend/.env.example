# Copy to .env for local development. Never commit a real .env file.
PORT=8787
NODE_ENV=development

# Generate a unique server-to-server token (at least 32 characters).
# Keep it in the hosting provider's secret manager, not in browser code.
QUILLSPARK_API_TOKEN=replace-with-a-random-64-character-secret

# OpenAI credentials stay server-side only.
OPENAI_API_KEY=
OPENAI_MODEL=

# PostgreSQL is required for persistent audit reports and human-review history.
DATABASE_URL=
DATABASE_SSL=false

# Comma-separated trusted website origins; leave empty for server-to-server only.
ALLOWED_ORIGINS=
