# Automated/integration testing. Use isolated test credentials and a disposable test database.
NODE_ENV=test
PORT=8788
QUILLSPARK_API_TOKEN=replace-with-a-unique-test-secret-at-least-32-characters
OPENAI_API_KEY=
OPENAI_MODEL=
DATABASE_URL=postgresql://localhost:5432/quillspark_test
DATABASE_SSL=false
ALLOWED_ORIGINS=http://localhost:3000
