# Shared pre-production sandbox. Store actual values in the hosting provider's secret manager.
NODE_ENV=production
PORT=8787
QUILLSPARK_API_TOKEN=SET_IN_SANDBOX_SECRET_MANAGER
OPENAI_API_KEY=SET_IN_SANDBOX_SECRET_MANAGER
OPENAI_MODEL=SET_TO_AN_ENABLED_SANDBOX_MODEL
DATABASE_URL=SET_IN_SANDBOX_SECRET_MANAGER
DATABASE_SSL=true
ALLOWED_ORIGINS=https://sandbox.example.com
