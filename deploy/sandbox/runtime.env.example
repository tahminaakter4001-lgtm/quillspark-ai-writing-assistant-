# Copy to runtime.env on the host. Never commit the real file.
POSTGRES_DB=quillspark_sandbox
POSTGRES_USER=quillspark
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD

# The hostname "db" is the Compose PostgreSQL service name.
DATABASE_URL=postgresql://quillspark:REPLACE_WITH_URL_ENCODED_PASSWORD@db:5432/quillspark_sandbox
QUILLSPARK_API_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
OPENAI_API_KEY=
OPENAI_MODEL=SET_A_MODEL_ENABLED_FOR_YOUR_OPENAI_PROJECT
ALLOWED_ORIGINS=
